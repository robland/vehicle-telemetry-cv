{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitoring-taxi.local/schemas/imu-event.schema.json",
  "title": "Taxi IMU Event",
  "description": "Schema for IMU events generated by the taxi edge device.",
  "type": "object",

  "properties": {

    "taxi_id": {
      "type": "string",
      "minLength": 1
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "acceleration_x_mps2": {
      "type": "number"
    },
    "acceleration_y_mps2": {
      "type": "number"
    },
    "acceleration_z_mps2": {
      "type": "number"
    },
    "gyroscope_x_rad_s": {
      "type": "number"
    },
    "gyroscope_y_rad_s": {
      "type": "number"
    },
    "gyroscope_z_rad_s": {
      "type": "number"
    }
  },

  "required": [
    "taxi_id",
    "timestamp",
    "acceleration_x_mps2",
    "acceleration_y_mps2",
    "acceleration_z_mps2",
    "gyroscope_x_rad_s",
    "gyroscope_y_rad_s",
    "gyroscope_z_rad_s"
  ],

  "additionalProperties": false
}