{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitoring-taxi.local/schemas/vision-event.schema.json",
  "title": "Taxi Vision Event",
  "description": "Schema for person detection and embedding events generated by the taxi edge device.",
  "type": "object",

  "properties": {

    "taxi_id": {
      "type": "string",
      "minLength": 1
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "event_type": {
      "type": "string",
      "enum": [
        "person_detected",
        "person_updated",
        "person_lost"
      ]
    },

    "camera_id": {
      "type": "string",
      "minLength": 1
    },

    "track_id": {
      "type": "integer",
      "minimum": 0
    },

    "bbox": {
      "type": "object",
      "properties": {
        "x_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "additionalProperties": false
    },

    "embedding_model": {
      "type": "string",
      "minLength": 1
    },
    "embedding_version": {
      "type": "string",
      "minLength": 1
    },
    "embedding_dimension": {
      "type": "integer",
      "minimum": 1
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1
    },


    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },

  "required": [
    "taxi_id",
    "timestamp",
    "event_type",
    "camera_id",
    "track_id",
    "bbox",
    "embedding",
    "confidence"
  ],

  "additionalProperties": false
}