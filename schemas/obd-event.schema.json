{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monitoring-taxi.local/schemas/obd-event.schema.json",
  "title": "Taxi OBD Event",
  "description": "Schema for OBD events generated by the taxi edge device.",
  "type": "object",

  "properties": {

    "taxi_id": {
      "type": "string",
      "minLength": 1
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "vehicle_speed_kmh": {
      "type": "number"
    },
    "engine_rpm": {
      "type": "number"
    },
    "coolant_temperature_c": {
      "type": "number"
    },
    "throttle_position_pct": {
      "type": "number"
    },
    "fuel_consumption_l_100km": {
      "type": "number"
    },
    "engine_load_pct": {
      "type": "number"
    },
    "diagnostic_codes": {
      "type": "array"
    }

  },

  "required": [
    "taxi_id",
    "timestamp",
    "vehicle_speed_kmh",
    "engine_rpm",
    "coolant_temperature_c",
    "throttle_position_pct",
    "fuel_consumption_l_100km",
    "engine_load_pct",
    "diagnostic_codes"
  ],

  "additionalProperties": false
}